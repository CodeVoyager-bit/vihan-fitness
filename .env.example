# Copy to .env.local (development) or set in your server's environment (production).
# Nothing secret is hard-coded in the app; there are no API keys to configure for the pilot.

# live | demo — the app refuses to open a database created in the other mode.
APP_MODE=live

# Where the SQLite file lives. Keep it OUTSIDE the project folder and include it in backups.
# Default: ~/.vihan-fitness/vihan.db (live) or ~/.vihan-fitness/demo.db (demo)
DATABASE_PATH=/var/lib/vihan-fitness/vihan.db

# Public address printed inside the QR posters (check-in and registration).
APP_URL=https://vihanfitness.example.in

# Only for testing over plain http on a local network (never in production).
# INSECURE_COOKIES=1

# Optional: fixed password for `npm run demo:seed` (otherwise a random one is printed).
# DEMO_PASSWORD=
