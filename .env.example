# Copy to .env.local (development) or set in your host's environment (Vercel → Settings → Environment Variables).
# Nothing secret is hard-coded in the app.

# live | demo — each mode has its own database (vihan_live / vihan_demo), so demo records never mix with real ones.
APP_MODE=live

# MongoDB Atlas → Connect → Drivers → Node.js. Replace <db_password> (URL-encode symbols like @ : / #).
# The database name is chosen by APP_MODE; anything after the last "/" is ignored.
MONGODB_URI=mongodb+srv://<user>:<db_password>@cluster0.xxxxx.mongodb.net/

# Signs session cookies. Generate once per environment: openssl rand -base64 32
BETTER_AUTH_SECRET=
# The app's public address (https in production).
BETTER_AUTH_URL=https://vihanfitness.example.in

# Public address printed inside the QR posters (check-in and registration).
APP_URL=https://vihanfitness.example.in

# Testing over plain http on a local network? Set BETTER_AUTH_URL to that http address (cookies follow it).

# Optional: password of every seeded demo account (default "vihan-demo"); the one-tap demo logins use it.
# DEMO_PASSWORD=

# Optional: photo uploads (member photos and website photos). Copy "API environment variable" from
# the Cloudinary dashboard. Without it the app hides the upload buttons.
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
